#include <bits/stdc++.h>
using namespace std;
int n;
vector <vector<int>>adj;
vector <int> target_sequence;
vector <int> bfs_sequence;
vector<bool> visited;
vector <int> relative_order;
void bfs()
{
	queue <int> q;
	q.push(1);
	visited[1]=true;
	while(!q.empty())
	{
		int u=q.front();
		q.pop();
		bfs_sequence.push_back(u);
		for(auto i:adj[u])
		{
			if(!visited[i])
			{
				visited[i]=true;
				q.push(i);
			}
		}
	}
}
int main()
{
	ios_base::sync_with_stdio(false);
	cin.tie(nullptr);
	cin>>n;
	adj.resize(n+1);
	target_sequence.resize(n);
	relative_order.resize(n+1);
	visited.resize(n+1,false);
	for(int i=1;i<n;i++)
	{
		int u,v;
		cin>>u>>v;
		adj[u].push_back(v);
		adj[v].push_back(u);
	}
	for(int i=0;i<n;i++)
	{
		cin>>target_sequence[i];
		relative_order[target_sequence[i]]=i;
	}
	for(int i=1;i<=n;i++)
	{
		sort(adj[i].begin(),adj[i].end(),[&](int a,int b)
		{
			return relative_order[a]<relative_order[b];
		});
	}
	bfs();
	if(bfs_sequence==target_sequence)
		cout<<"YES
";
	else
		cout<<"NO
";
	return 0;
}